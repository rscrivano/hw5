# Copy to .env (same folder as README.md) if PORTKEY_API_KEY isn't already set in your environment.
PORTKEY_API_KEY=
# Optional - only if your Portkey workspace needs a provider slug to route gpt-6-luna (e.g. @my-openai)
PORTKEY_PROVIDER=
# Optional token guard rails (defaults shown)
CC_MAX_OUTPUT_TOKENS=6000
CC_REASONING_EFFORT=low
CC_MAX_REQUESTS_PER_TICKET=40
CC_MAX_TOKENS_PER_TICKET=120000
CC_MAX_DELEGATION_DEPTH=3
CC_MAX_TASKS_PER_AGENT_PER_TICKET=3
